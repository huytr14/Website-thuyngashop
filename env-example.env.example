# Sao chép thành .env.local và điền giá trị thật (không commit file .env.local)

# Đường dẫn website chính thức (để trống khi chạy local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Supabase hoặc Neon) — dùng cho Drizzle ORM từ giai đoạn P1
DATABASE_URL=

# Mật khẩu vào trang quản trị /admin — tự đặt, đủ mạnh
ADMIN_PASSWORD=

# Auth.js — tạo chuỗi ngẫu nhiên dài, không dùng chung với ADMIN_PASSWORD
AUTH_SECRET=

# Resend (để trống để mô phỏng gửi email trong log, không gửi thật)
RESEND_API_KEY=
RESEND_FROM_EMAIL=THUYNGA Shop <onboarding@resend.dev>

# Cloudflare Turnstile cho form liên hệ (để trống để tắt)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis REST — để trống sẽ dùng rate limit in-memory một tiến trình
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

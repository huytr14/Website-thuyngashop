{
  "name": "olala-select-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:admin && npm run test:commerce && npm run test:e2e",
    "test:csv": "node --experimental-strip-types --test tests/csv-import.test.ts",
    "test:admin": "node --experimental-strip-types --test tests/csv-import.test.ts tests/login-rate-limit.test.ts tests/media-storage.test.ts",
    "test:commerce": "node --experimental-strip-types --test tests/cart.test.ts tests/commerce.test.ts tests/password.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:backfill-media": "node --experimental-strip-types scripts/backfill-media.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "react-server-dom-webpack": "^19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.3.0",
    "vite": "^8.3.5"
  },
  "type": "module"
}
